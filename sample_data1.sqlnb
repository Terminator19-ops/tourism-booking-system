    languageId: oracle-sql
  - kind: 2
    value: "INSERT INTO Travel_Segment (\r

      \    travel_segment_id,\r

      \    origin_destination_id,\r

      \    destination_destination_id,\r

      \    transport_type,\r

      \    operator_name,\r

      \    departure_time,\r

      \    arrival_time,\r

      \    price,\r

      \    capacity,\r

      \    status\r

      )\r

      VALUES (\r

      \    travel_segment_seq.NEXTVAL,\r

      \    1,\r

      \    2,\r

      \    'BUS',\r

      \    'KSRTC',\r

      \    TIMESTAMP '2026-10-01 08:00:00',\r

      \    TIMESTAMP '2026-10-01 11:00:00',\r

      \    500,\r

      \    40,\r

      \    'SCHEDULED'\r

      );\r

      \r

