cells:
  - kind: 2
    value: "CREATE SEQUENCE SEQ_ROOM_BLOCK START WITH 1 INCREMENT BY 1 NOCACHE;\r

      \r

      CREATE TABLE Room_Block (\r

      \    block_id    NUMBER        NOT NULL,\r

      \    room_id     NUMBER        NOT NULL,\r

      \    start_date  DATE          NOT NULL,\r

      \    end_date    DATE          NOT NULL,\r

      \    reason      VARCHAR2(200),\r

      \    created_by  NUMBER        NOT NULL,\r

      \    created_at  TIMESTAMP     DEFAULT CURRENT_TIMESTAMP NOT NULL,\r

      \    CONSTRAINT PK_ROOM_BLOCK  PRIMARY KEY (block_id),\r

      \    CONSTRAINT FK_RB_ROOM     FOREIGN KEY (room_id)    REFERENCES
      Room(room_id),\r

      \    CONSTRAINT FK_RB_USER     FOREIGN KEY (created_by) REFERENCES
      App_User(user_id),\r

      \    CONSTRAINT CK_RB_DATES    CHECK (end_date > start_date)\r

      );\r

      \r

      CREATE OR REPLACE FUNCTION fn_check_room_availability(\r

      \    p_room_id   IN NUMBER,\r

      \    p_check_in  IN DATE,\r

      \    p_check_out IN DATE\r

      ) RETURN VARCHAR2\r

      IS\r

      \    v_conflict NUMBER;\r

      \    v_blocked  NUMBER;\r

      \    v_status   VARCHAR2(20);\r

      BEGIN\r

      \    SELECT status INTO v_status FROM Room WHERE room_id = p_room_id;\r

      \    IF v_status = 'MAINTENANCE' THEN\r

      \        RETURN 'NOT AVAILABLE';\r

      \    END IF;\r

      \r

      \    SELECT COUNT(*) INTO v_conflict\r

      \    FROM Hotel_Booking hb JOIN Booking b ON hb.booking_id =
      b.booking_id\r

      \    WHERE hb.room_id = p_room_id\r

      \      AND b.status NOT IN ('CANCELLED')\r

      \      AND p_check_in < hb.check_out_date\r

      \      AND p_check_out > hb.check_in_date;\r

      \r

      \    SELECT COUNT(*) INTO v_blocked\r

      \    FROM Room_Block\r

      \    WHERE room_id = p_room_id\r

      \      AND p_check_in < end_date\r

      \      AND p_check_out > start_date;\r

      \r

      \    IF v_conflict > 0 OR v_blocked > 0 THEN\r

      \        RETURN 'NOT AVAILABLE';\r

      \    END IF;\r

      \    RETURN 'AVAILABLE';\r

      EXCEPTION\r

      \    WHEN NO_DATA_FOUND THEN RETURN 'NOT AVAILABLE';\r

      END;\r

      /"
    languageId: oracle-sql
  - kind: 2
    value: "DECLARE v NUMBER;\r

      BEGIN\r

      \  FOR t IN (SELECT 'APP_USER' tn,'user_id' c,'user_seq' s FROM dual UNION
      ALL\r

      \            SELECT 'DESTINATION','destination_id','seq_destination' FROM
      dual UNION ALL\r

      \            SELECT 'HOTEL','hotel_id','seq_hotel' FROM dual UNION ALL\r

      \            SELECT 'ROOM','room_id','seq_room' FROM dual UNION ALL\r

      \            SELECT 'ACTIVITY','activity_id','seq_activity' FROM dual
      UNION ALL\r

      \            SELECT 'TOUR_PACKAGE','package_id','seq_package' FROM dual
      UNION ALL\r

      \            SELECT
      'TRAVEL_SEGMENT','travel_segment_id','seq_travel_segment' FROM dual UNION
      ALL\r

      \            SELECT 'REPORT','report_id','seq_report' FROM dual) LOOP\r

      \    EXECUTE IMMEDIATE 'SELECT NVL(MAX('||t.c||'),0)+1 FROM '||t.tn INTO
      v;\r

      \    BEGIN EXECUTE IMMEDIATE 'DROP SEQUENCE '||t.s; EXCEPTION WHEN OTHERS
      THEN NULL; END;\r

      \    EXECUTE IMMEDIATE 'CREATE SEQUENCE '||t.s||' START WITH '||v||'
      NOCACHE';\r

      \  END LOOP;\r

      END;\r

      /"
    languageId: oracle-sql
